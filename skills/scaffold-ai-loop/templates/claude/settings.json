      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git worktree list*)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git checkout * -- *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push -u origin HEAD)",
